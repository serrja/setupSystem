"""Existing-user Debian backend used from the supported ansible-core releases."""

from collections.abc import Mapping
from typing import Literal, Never, Protocol

class _UserModule(Protocol):
    @property
    def params(self) -> Mapping[str, object]: ...
    @property
    def check_mode(self) -> bool: ...
    def get_bin_path(self, name: str, required: bool) -> str: ...
    def fail_json(self, **details: object) -> Never: ...
    def run_command(
        self, argv: list[str], *, use_unsafe_shell: bool = ..., data: bytes | None = ...
    ) -> tuple[int, str, str]: ...

class User:
    def __init__(self, module: _UserModule) -> None: ...
    def get_pwd_info(self) -> list[str | int] | Literal[False]: ...
    def modify_user_usermod(self) -> tuple[int | None, str, str]: ...
