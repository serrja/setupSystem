{
  "id": "firefox",
  "name": "Firefox ESR",
  "author": "serrja",
  "category": "applications",
  "kind": "application",
  "sdk": ">=1.1,<2",
  "entry_point": "setup_plugin_firefox:Plugin",
  "version": "1.0.1",
  "source": "https://github.com/serrja/setupSystem",
  "permissions": [
    "root"
  ],
  "capabilities": [
    "enterprise-policy",
    "tracking-protection"
  ],
  "dependencies": [],
  "actions": [
    {
      "cleanup_phase": null,
      "id": "install",
      "label": "Install",
      "page": "actions",
      "target": "install",
      "permissions": [
        "root"
      ],
      "supports_rollback": false,
      "read_only": false,
      "description": ""
    },
    {
      "cleanup_phase": null,
      "id": "update",
      "label": "Update",
      "page": "actions",
      "target": "update",
      "permissions": [
        "root"
      ],
      "supports_rollback": false,
      "read_only": false,
      "description": ""
    },
    {
      "cleanup_phase": "program",
      "id": "uninstall",
      "label": "Uninstall",
      "page": "actions",
      "target": "uninstall",
      "permissions": [
        "root"
      ],
      "supports_rollback": false,
      "read_only": false,
      "description": ""
    },
    {
      "cleanup_phase": null,
      "id": "check",
      "label": "Check Firefox",
      "page": "actions",
      "target": null,
      "permissions": [],
      "supports_rollback": false,
      "read_only": false,
      "description": ""
    },
    {
      "cleanup_phase": null,
      "id": "configure",
      "label": "Configure privacy policy",
      "page": "actions",
      "target": "configure",
      "permissions": [
        "root"
      ],
      "supports_rollback": false,
      "read_only": false,
      "description": ""
    },
    {
      "cleanup_phase": "local",
      "id": "remove-policy",
      "label": "Remove generated policy",
      "page": "actions",
      "target": "remove-policy",
      "permissions": [
        "root"
      ],
      "supports_rollback": false,
      "read_only": false,
      "description": ""
    }
  ],
  "environment_fields": {},
  "settings_schema": {
    "additionalProperties": false,
    "properties": {
      "protection": {
        "default": "strict",
        "enum": [
          "strict",
          "standard"
        ],
        "title": "Tracking protection",
        "type": "string"
      },
      "https_only": {
        "default": true,
        "title": "HTTPS-only browsing",
        "type": "boolean"
      },
      "install_ublock": {
        "default": false,
        "title": "Install uBlock Origin from Mozilla Add-ons",
        "type": "boolean"
      }
    },
    "title": "Settings",
    "type": "object"
  },
  "input_schemas": {
    "install": {
      "additionalProperties": false,
      "properties": {},
      "title": "Inputs",
      "type": "object"
    },
    "update": {
      "additionalProperties": false,
      "properties": {},
      "title": "Inputs",
      "type": "object"
    },
    "uninstall": {
      "additionalProperties": false,
      "properties": {},
      "title": "Inputs",
      "type": "object"
    },
    "check": {
      "additionalProperties": false,
      "properties": {},
      "title": "Inputs",
      "type": "object"
    },
    "configure": {
      "additionalProperties": false,
      "properties": {},
      "title": "Inputs",
      "type": "object"
    },
    "remove-policy": {
      "additionalProperties": false,
      "properties": {},
      "title": "Inputs",
      "type": "object"
    }
  },
  "pages": [
    "Overview",
    "Settings",
    "Actions",
    "Managed resources",
    "History",
    "Help"
  ],
  "settings_version": 1
}
