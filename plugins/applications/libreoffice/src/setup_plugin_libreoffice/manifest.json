{
  "id": "libreoffice",
  "name": "LibreOffice",
  "author": "serrja",
  "category": "applications",
  "kind": "application",
  "sdk": ">=1.1,<2",
  "entry_point": "setup_plugin_libreoffice:Plugin",
  "version": "1.0.1",
  "source": "https://github.com/serrja/setupSystem",
  "permissions": [
    "root",
    "user-files"
  ],
  "capabilities": [
    "debian-package"
  ],
  "dependencies": [],
  "actions": [
    {
      "cleanup_phase": null,
      "id": "install",
      "label": "Install",
      "page": "actions",
      "target": "install",
      "permissions": [
        "root"
      ],
      "supports_rollback": false,
      "read_only": false,
      "description": ""
    },
    {
      "cleanup_phase": null,
      "id": "update",
      "label": "Update",
      "page": "actions",
      "target": "update",
      "permissions": [
        "root"
      ],
      "supports_rollback": false,
      "read_only": false,
      "description": ""
    },
    {
      "cleanup_phase": "program",
      "id": "uninstall",
      "label": "Uninstall",
      "page": "actions",
      "target": "uninstall",
      "permissions": [
        "root"
      ],
      "supports_rollback": false,
      "read_only": false,
      "description": ""
    },
    {
      "cleanup_phase": null,
      "id": "check",
      "label": "Check LibreOffice",
      "page": "actions",
      "target": null,
      "permissions": [],
      "supports_rollback": false,
      "read_only": false,
      "description": ""
    },
    {
      "cleanup_phase": null,
      "id": "preferences",
      "label": "Preferences",
      "page": "actions",
      "target": null,
      "permissions": [],
      "supports_rollback": false,
      "read_only": false,
      "description": ""
    },
    {
      "cleanup_phase": null,
      "id": "recovery",
      "label": "Recovery",
      "page": "actions",
      "target": null,
      "permissions": [],
      "supports_rollback": false,
      "read_only": false,
      "description": ""
    },
    {
      "cleanup_phase": null,
      "id": "configure-launcher",
      "label": "Save application launcher",
      "page": "actions",
      "target": "configure-launcher",
      "permissions": [
        "user-files"
      ],
      "supports_rollback": true,
      "read_only": false,
      "description": ""
    }
  ],
  "environment_fields": {},
  "settings_schema": {
    "additionalProperties": false,
    "properties": {
      "component": {
        "default": "start-center",
        "enum": [
          "start-center",
          "writer",
          "calc",
          "impress"
        ],
        "title": "Start component",
        "type": "string"
      }
    },
    "title": "Settings",
    "type": "object"
  },
  "input_schemas": {
    "install": {
      "additionalProperties": false,
      "properties": {},
      "title": "Inputs",
      "type": "object"
    },
    "update": {
      "additionalProperties": false,
      "properties": {},
      "title": "Inputs",
      "type": "object"
    },
    "uninstall": {
      "additionalProperties": false,
      "properties": {},
      "title": "Inputs",
      "type": "object"
    },
    "check": {
      "additionalProperties": false,
      "properties": {},
      "title": "Inputs",
      "type": "object"
    },
    "configure-launcher": {
      "additionalProperties": false,
      "properties": {
        "profile_id": {
          "pattern": "^[a-z][a-z0-9_-]{0,47}$",
          "title": "Launcher profile ID",
          "type": "string"
        },
        "name": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Application menu label",
          "type": "string"
        }
      },
      "required": [
        "profile_id",
        "name"
      ],
      "title": "LauncherProfile",
      "type": "object"
    },
    "preferences": {
      "additionalProperties": false,
      "properties": {},
      "title": "Inputs",
      "type": "object"
    },
    "recovery": {
      "additionalProperties": false,
      "properties": {},
      "title": "Inputs",
      "type": "object"
    }
  },
  "pages": [
    "Overview",
    "Settings",
    "Actions",
    "Managed resources",
    "History",
    "Help"
  ],
  "settings_version": 1
}
