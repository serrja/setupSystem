    },
    {
      "cleanup_phase": null,
      "id": "revoke-key",
      "label": "Revoke owned SSH key",
      "page": "accounts",
      "target": "revoke-key",
      "permissions": [
        "account-keys"
      ],
      "supports_rollback": false,
      "description": ""
    },
    {
      "cleanup_phase": null,
      "id": "import-profile",
      "label": "Import repository identity",
      "page": "actions",
      "target": "import-profile",
      "permissions": [
        "user-files"
      ],
      "supports_rollback": true,
      "description": ""
    },
    {
      "cleanup_phase": null,
      "id": "use-profile",
      "label": "Apply profile to checkout",
      "page": "actions",
      "target": "use-profile",
      "permissions": [
        "user-files"
      ],
      "supports_rollback": true,
      "description": ""
    },
    {
      "cleanup_phase": "remote",
      "id": "remove-owned-keys",
      "label": "Revoke managed SSH keys",
      "page": "accounts",
      "target": "remove-owned-keys",
      "permissions": [
        "account-keys"
      ],
      "supports_rollback": false,
      "description": ""
    },
    {
      "cleanup_phase": null,
      "id": "configure-style",
      "label": "Configure colors and aliases",
      "page": "actions",
      "target": "configure-style",
      "permissions": [
        "user-files"
      ],
      "supports_rollback": true,
      "description": ""
    },
    {
      "cleanup_phase": null,
      "id": "verify-ssh",
      "label": "Verify SSH account access",
      "page": "accounts",
      "target": null,
      "permissions": [
        "account-keys"
      ],
      "supports_rollback": false,
      "description": ""
    }
  ],
  "environment_fields": {},
  "settings_schema": {
    "additionalProperties": false,
    "properties": {
      "enterprise_host": {
        "default": "",
        "description": "Enter the exact GitHub Enterprise DNS hostname you intend to use.",
        "maxLength": 253,
        "pattern": "^$|^([a-z0-9]([a-z0-9-]*[a-z0-9])?\\.)+[a-z]([a-z0-9-]*[a-z0-9])?$",
        "title": "Approved enterprise host",
        "type": "string"
      }
    },
    "title": "Settings",
    "type": "object"
  },
  "input_schemas": {
    "install": {
      "additionalProperties": false,
      "properties": {},
      "title": "Inputs",
      "type": "object"
    },
    "update": {
      "additionalProperties": false,
      "properties": {},
      "title": "Inputs",
      "type": "object"
    },
    "uninstall": {
      "additionalProperties": false,
      "properties": {},
      "title": "Inputs",
      "type": "object"
    },
    "upload-key": {
      "additionalProperties": false,
      "properties": {
        "host": {
          "default": "github.com",
          "maxLength": 253,
          "minLength": 1,
          "title": "Host",
          "type": "string"
        },
        "account": {
          "maxLength": 100,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]*$",
          "title": "Account",
          "type": "string"
        },
        "public_key": {
          "format": "path",
          "title": "OpenSSH public key",
          "type": "string",
          "ui": {
            "widget": "path"
          }
        },
        "title": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "account",
        "public_key",
        "title"
      ],
      "title": "Upload",
      "type": "object"
    },
    "verify-ssh": {
      "additionalProperties": false,
      "properties": {
        "host": {
          "default": "github.com",
          "maxLength": 253,
          "minLength": 1,
          "title": "Host",
          "type": "string"
        },
        "account": {
          "maxLength": 100,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]*$",
          "title": "Account",
          "type": "string"
        },
        "public_key": {
          "format": "path",
          "title": "OpenSSH public key",
          "type": "string",
          "ui": {
            "widget": "path"
          }
        },
        "login": {
          "default": "git",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,63}$",
          "title": "SSH transport user",
          "type": "string"
        }
      },
      "required": [
        "account",
        "public_key"
      ],
      "title": "Probe",
      "type": "object"
    },
    "revoke-key": {
      "additionalProperties": false,
      "properties": {
        "host": {
          "default": "github.com",
          "maxLength": 253,
          "minLength": 1,
          "title": "Host",
          "type": "string"
        },
        "account": {
          "maxLength": 100,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]*$",
          "title": "Account",
          "type": "string"
        },
        "key_id": {
          "exclusiveMinimum": 0,
          "title": "Remote key ID",
          "type": "integer"
        }
      },
      "required": [
        "account",
        "key_id"
      ],
      "title": "Revoke",
      "type": "object"
    },
    "configure": {
      "additionalProperties": false,
      "properties": {
        "profile": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_-]*$",
          "title": "Profile name",
          "type": "string"
        },
        "directory": {
          "description": "Apply this identity to repositories under this existing directory.",
          "format": "path",
          "title": "Repository directory",
          "type": "string",
          "ui": {
            "widget": "path"
          }
        },
        "name": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Commit author",
          "type": "string"
        },
        "email": {
          "maxLength": 254,
          "pattern": "^[^@\\s<>]+@[^@\\s<>]+$",
          "title": "Commit email",
          "type": "string"
        },
        "editor": {
          "default": "nvim",
          "enum": [
            "nvim",
            "vim",
            "nano"
          ],
          "title": "Commit editor",
          "type": "string"
        },
        "signing_key": {
          "default": "",
          "description": "Full OpenPGP fingerprint. Leave empty for unsigned commits.",
          "pattern": "^([0-9A-Fa-f]{40}|[0-9A-Fa-f]{64})?$",
          "title": "Signing Key",
          "type": "string"
        }
      },
      "required": [
        "profile",
        "directory",
        "name",
        "email"
      ],
      "title": "Profile",
      "type": "object"
    },
    "configure-style": {
      "additionalProperties": false,
      "description": "Install the optional Git color and alias fragment.",
      "properties": {},
      "title": "Style",
      "type": "object"
    },
    "import-profile": {
      "additionalProperties": false,
      "description": "Save the selected repository identity in a private fragment.",
      "properties": {
        "profile": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_-]*$",
          "title": "Profile name",
          "type": "string"
        },
        "repository": {
          "format": "path",
          "title": "Checkout root",
          "type": "string",
          "ui": {
            "widget": "path"
          }
        }
      },
      "required": [
        "profile",
        "repository"
      ],
      "title": "ImportProfile",
      "type": "object"
    },
    "use-profile": {
      "additionalProperties": false,
      "description": "Override identity only inside this exact repository.",
      "properties": {
        "profile": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_-]*$",
          "title": "Profile name",
          "type": "string"
        },
        "repository": {
          "format": "path",
          "title": "Checkout root",
          "type": "string",
          "ui": {
            "widget": "path"
          }
        }
      },
      "required": [
        "profile",
        "repository"
      ],
      "title": "UseProfile",
      "type": "object"
    },
    "check": {
      "additionalProperties": false,
      "properties": {},
      "title": "Inputs",
      "type": "object"
    },
    "status": {
      "additionalProperties": false,
      "properties": {
        "host": {
          "default": "github.com",
          "maxLength": 253,
          "minLength": 1,
          "title": "Git hosting service",
          "type": "string"
        }
      },
      "title": "Account",
      "type": "object"
    },
    "login": {
      "additionalProperties": false,
      "properties": {
        "host": {
          "default": "github.com",
          "maxLength": 253,
          "minLength": 1,
          "title": "Git hosting service",
          "type": "string"
        }
      },
      "title": "Account",
      "type": "object"
    },
    "logout": {
      "additionalProperties": false,
      "properties": {
        "host": {
          "default": "github.com",
          "maxLength": 253,
          "minLength": 1,
          "title": "Host",
          "type": "string"
        },
        "account": {
          "maxLength": 100,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]*$",
          "title": "Account",
          "type": "string"
        }
      },
      "required": [
        "account"
      ],
      "title": "KeyAccount",
      "type": "object"
    },
    "remove-owned-keys": {
      "additionalProperties": false,
      "properties": {},
      "title": "CleanupKeys",
      "type": "object"
    },
    "generate-key": {
      "additionalProperties": false,
      "properties": {},
      "title": "Inputs",
      "type": "object"
    }
  },
  "pages": [
    "Overview",
    "Settings",
    "Accounts",
    "Actions",
    "Managed resources",
    "History",
    "Help"
  ],
  "settings_version": 1
}
