{
  "id": "git",
  "name": "Git",
  "author": "serrja",
  "category": "applications",
  "kind": "application",
  "sdk": ">=1,<2",
  "entry_point": "setup_plugin_git:Plugin",
  "version": "1.0.0",
  "source": "https://github.com/serrja/setupSystem",
  "permissions": [
    "user-files",
    "account-status",
    "root",
    "account-keys",
    "ui-code"
  ],
  "capabilities": [
    "author-profiles",
    "github-auth"
  ],
  "dependencies": [],
  "actions": [
    {
      "cleanup_phase": null,
      "id": "check",
      "label": "Check Git",
      "page": "actions",
      "target": null,
      "permissions": [],
      "supports_rollback": false,
      "description": ""
    },
    {
      "cleanup_phase": null,
      "id": "configure",
      "label": "Configure author profile",
      "page": "actions",
      "target": "configure",
      "permissions": [
        "user-files"
      ],
      "supports_rollback": true,
      "description": ""
    },
    {
      "cleanup_phase": null,
      "id": "status",
      "label": "Account status",
      "page": "accounts",
      "target": null,
      "permissions": [
        "account-status"
      ],
      "supports_rollback": false,
      "description": ""
    },
    {
      "cleanup_phase": null,
      "id": "login",
      "label": "Sign in",
      "page": "accounts",
      "target": null,
      "permissions": [],
      "supports_rollback": false,
      "description": ""
    },
    {
      "cleanup_phase": null,
      "id": "logout",
      "label": "Sign out",
      "page": "accounts",
      "target": "logout",
      "permissions": [],
      "supports_rollback": false,
      "description": ""
    },
    {
      "cleanup_phase": null,
      "id": "generate-key",
      "label": "Create an SSH key",
      "page": "accounts",
      "target": null,
      "permissions": [],
      "supports_rollback": false,
      "description": ""
    },
    {
      "cleanup_phase": null,
      "id": "install",
      "label": "Install",
      "page": "actions",
      "target": "install",
      "permissions": [
        "root"
      ],
      "supports_rollback": false,
      "description": ""
    },
    {
      "cleanup_phase": null,
      "id": "update",
      "label": "Update",
      "page": "actions",
      "target": "update",
      "permissions": [
        "root"
      ],
      "supports_rollback": false,
      "description": ""
    },
    {
      "cleanup_phase": "program",
      "id": "uninstall",
      "label": "Uninstall",
      "page": "actions",
      "target": "uninstall",
      "permissions": [
        "root"
      ],
      "supports_rollback": false,
