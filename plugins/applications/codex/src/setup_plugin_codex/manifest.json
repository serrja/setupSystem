      "target": null,
      "permissions": [],
      "supports_rollback": false,
      "description": ""
    },
    {
      "cleanup_phase": null,
      "id": "install",
      "label": "Install official CLI",
      "page": "actions",
      "target": "install",
      "permissions": [
        "user-files"
      ],
      "supports_rollback": false,
      "description": ""
    },
    {
      "cleanup_phase": null,
      "id": "update",
      "label": "Update official CLI",
      "page": "actions",
      "target": "update",
      "permissions": [
        "user-files"
      ],
      "supports_rollback": false,
      "description": ""
    },
    {
      "cleanup_phase": null,
      "id": "configure",
      "label": "Configure client",
      "page": "actions",
      "target": "configure",
      "permissions": [
        "user-files"
      ],
      "supports_rollback": false,
      "description": ""
    },
    {
      "cleanup_phase": null,
      "id": "login",
      "label": "Sign in",
      "page": "accounts",
      "target": null,
      "permissions": [],
      "supports_rollback": false,
      "description": ""
    },
    {
      "cleanup_phase": null,
      "id": "status",
      "label": "Account status",
      "page": "accounts",
      "target": null,
      "permissions": [
        "account-status"
      ],
      "supports_rollback": false,
      "description": ""
    },
    {
      "cleanup_phase": null,
      "id": "logout",
      "label": "Sign out",
      "page": "accounts",
      "target": "logout",
      "permissions": [
        "account-status"
      ],
      "supports_rollback": false,
      "description": ""
    },
    {
      "cleanup_phase": null,
      "id": "mcp",
      "label": "Manage MCP servers",
      "page": "actions",
      "target": null,
      "permissions": [],
      "supports_rollback": false,
      "description": ""
