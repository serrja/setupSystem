{
  "id": "codex",
  "name": "Codex CLI",
  "author": "serrja",
  "category": "applications",
  "kind": "application",
  "sdk": ">=1,<2",
  "entry_point": "setup_plugin_codex:Plugin",
  "version": "1.0.0",
  "source": "https://github.com/serrja/setupSystem",
  "permissions": [
    "user-files",
    "account-status"
  ],
