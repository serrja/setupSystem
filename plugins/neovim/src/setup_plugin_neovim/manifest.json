  "session_fields": [],
  "environment_fields": {},
  "settings_schema": {
    "additionalProperties": false,
    "properties": {
      "languages": {
        "description": "Select the language support to configure in Neovim.",
        "items": {
          "const": "python",
          "type": "string"
        },
        "maxItems": 1,
        "title": "Editor languages",
        "type": "array",
        "ui": {
          "widget": "selection_list",
          "storage": "settings",
          "secret": false,
          "visible_when": {},
          "choice_provider": null
        },
        "default": []
      },
      "clipboard": {
        "default": true,
        "description": "Use the desktop clipboard when a Wayland session is available.",
        "title": "Use Wayland clipboard when available",
        "type": "boolean",
        "ui": {
          "storage": "settings",
          "secret": false,
          "visible_when": {},
          "choice_provider": null
        }
      },
      "primary_editor": {
        "default": true,
        "description": "Set Neovim as the editor for subsequent login sessions.",
        "title": "Set Neovim as the login editor",
        "type": "boolean",
        "ui": {
          "storage": "settings",
          "secret": false,
          "visible_when": {},
          "choice_provider": null
        }
      }
    },
    "title": "Settings",
    "type": "object"
  },
