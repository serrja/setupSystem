{
  "id": "neovim",
  "name": "Neovim",
  "author": "serrja",
  "category": "applications",
  "kind": "application",
  "sdk": ">=3,<4",
  "entry_point": "setup_plugin_neovim.plugin:Plugin",
  "version": "2.0.0",
  "source": "https://github.com/serrja/setupSystem",
  "permissions": [
    "root",
    "user-files"
  ],
  "provides": [],
