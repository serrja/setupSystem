  "environment_fields": {},
  "settings_schema": {
    "additionalProperties": false,
    "description": "Resolve one current configuration from the sources accepted by the plugin.",
    "properties": {},
    "title": "PluginSettings",
    "type": "object"
  },
  "input_schemas": {
    "install": {
      "additionalProperties": false,
      "properties": {},
      "title": "Inputs",
      "type": "object"
    },
    "update": {
      "additionalProperties": false,
      "properties": {},
      "title": "Inputs",
      "type": "object"
    },
    "uninstall": {
      "additionalProperties": false,
      "properties": {},
      "title": "Inputs",
      "type": "object"
    },
    "check": {
      "additionalProperties": false,
      "properties": {},
      "title": "Inputs",
      "type": "object"
    },
    "configure": {
      "additionalProperties": false,
      "properties": {},
      "title": "Inputs",
      "type": "object"
    },
    "verify-startup": {
      "$defs": {
        "Terminal": {
          "additionalProperties": false,
          "properties": {
            "name": {
              "const": "TERM",
              "default": "TERM",
              "description": "Set the approved terminal environment variable for this invocation.",
              "title": "Name",
              "type": "string",
              "ui": {
                "storage": "action",
                "secret": false,
                "visible_when": {},
                "choice_provider": null
              }
            },
            "value": {
              "default": "xterm-256color",
              "description": "Choose the terminal value presented to the shell during this check.",
              "enum": [
                "xterm-256color",
                "xterm",
                "dumb"
              ],
              "title": "Value",
              "type": "string",
              "ui": {
                "storage": "action",
                "secret": false,
                "visible_when": {},
                "choice_provider": null
              }
            },
            "scope": {
              "const": "command",
              "default": "command",
              "description": "Apply this value only to the selected command.",
              "title": "Scope",
              "type": "string",
              "ui": {
                "storage": "action",
                "secret": false,
                "visible_when": {},
                "choice_provider": null
              }
            }
          },
          "title": "Terminal",
          "type": "object"
        }
      },
      "additionalProperties": false,
      "properties": {
        "flags": {
          "default": [
            "-c",
            "-ic",
            "-lic"
          ],
          "description": "Native startup modes to verify in an isolated home.",
          "items": {
            "enum": [
              "-c",
              "-ic",
              "-lic"
            ],
            "type": "string"
          },
          "maxItems": 3,
          "minItems": 1,
          "title": "Flags",
          "type": "array",
          "ui": {
            "storage": "action",
            "secret": false,
            "visible_when": {},
            "choice_provider": null
          }
        },
        "environment": {
          "default": [],
          "description": "Terminal settings for this check.",
          "items": {
            "$ref": "#/$defs/Terminal"
          },
          "maxItems": 1,
          "title": "Environment",
          "type": "array",
          "ui": {
            "storage": "action",
            "secret": false,
            "visible_when": {},
            "choice_provider": null
          }
        }
      },
      "title": "Startup",
      "type": "object"
    }
  },
  "pages": [],
  "settings_version": 1
}
