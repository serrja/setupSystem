  ],
  "capabilities": [],
  "dependencies": [],
  "actions": [
    {
      "cleanup_phase": null,
      "id": "check",
      "label": "Check Zsh",
      "page": "actions",
      "target": null,
      "permissions": [],
      "supports_rollback": false,
      "mode": "read_only",
      "description": ""
    },
    {
      "cleanup_phase": null,
      "id": "install",
      "label": "Install Zsh",
      "page": "actions",
      "target": "install",
      "permissions": [
        "root"
      ],
      "supports_rollback": false,
      "mode": "mutation",
      "description": ""
    },
    {
      "cleanup_phase": null,
      "id": "update",
      "label": "Update Zsh",
      "page": "actions",
      "target": "update",
      "permissions": [
        "root"
      ],
      "supports_rollback": false,
      "mode": "mutation",
      "description": ""
    },
    {
      "cleanup_phase": "program",
      "id": "uninstall",
      "label": "Uninstall Zsh",
      "page": "actions",
      "target": "uninstall",
      "permissions": [
        "root"
      ],
      "supports_rollback": false,
      "mode": "mutation",
      "description": ""
    },
    {
      "cleanup_phase": null,
      "id": "configure",
      "label": "Configure Zsh",
      "page": "actions",
      "target": "configure",
      "permissions": [
        "user-files"
      ],
      "supports_rollback": false,
      "mode": "mutation",
      "description": ""
    },
    {
      "cleanup_phase": null,
      "id": "verify-startup",
      "label": "Verify Zsh startup modes",
      "page": "actions",
      "target": null,
      "permissions": [],
      "supports_rollback": false,
      "mode": "read_only",
      "description": ""
    }
