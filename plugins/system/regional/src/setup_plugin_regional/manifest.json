{
  "id": "regional",
  "name": "Regional settings",
  "author": "serrja",
  "category": "system",
  "kind": "system",
  "sdk": ">=1,<2",
  "entry_point": "setup_plugin_regional:Plugin",
  "version": "1.0.0",
  "source": "https://github.com/serrja/setupSystem",
  "permissions": [
    "root"
  ],
  "capabilities": [
    "locale-generation",
    "console-keyboard"
  ],
  "dependencies": [],
  "actions": [
    {
      "id": "update",
      "label": "Update regional tools",
      "target": "update",
      "permissions": [
        "root"
      ],
      "supports_rollback": false,
      "description": "Use the signed Debian locale and console keyboard packages."
    },
    {
      "id": "install",
      "label": "Install regional tools",
      "target": "install",
      "permissions": [
        "root"
      ],
      "supports_rollback": false,
      "description": "Use the signed Debian locale and console keyboard packages."
    },
    {
      "id": "timezone",
      "label": "Set timezone",
      "target": "timezone",
      "permissions": [
        "root"
      ],
      "supports_rollback": false,
      "description": ""
    },
    {
      "id": "locale",
      "label": "Set locale",
      "target": "locale",
      "permissions": [
        "root"
      ],
      "supports_rollback": false,
      "description": ""
    },
    {
      "id": "keyboard",
      "label": "Set keyboard",
      "target": "keyboard",
      "permissions": [
        "root"
      ],
      "supports_rollback": false,
      "description": ""
    }
  ],
  "settings_schema": {
    "additionalProperties": false,
    "description": "Load only caller-selected sources and explicitly declared environment names.",
    "properties": {},
    "title": "PluginSettings",
    "type": "object"
  },
  "input_schemas": {
    "locale": {
      "additionalProperties": false,
      "properties": {
        "value": {
          "maxLength": 32,
          "pattern": "^(C|[a-z]{2,3}_[A-Z]{2})\\.UTF-8$",
          "title": "UTF-8 locale",
          "type": "string",
          "ui": {
            "choice_provider": "locale",
            "widget": "select"
          }
        }
      },
      "required": [
        "value"
      ],
      "title": "Locale",
      "type": "object"
    },
    "keyboard": {
      "additionalProperties": false,
      "properties": {
        "layouts": {
          "description": "The first selected layout is the default.",
          "items": {
            "pattern": "^[a-z][a-z0-9_-]{0,15}$",
            "type": "string"
          },
          "maxItems": 4,
          "minItems": 1,
          "title": "Keyboard layouts in order",
          "type": "array",
          "ui": {
            "choice_provider": "keyboard",
            "widget": "selection_list"
          }
        }
      },
      "required": [
        "layouts"
      ],
      "title": "Keyboard",
      "type": "object"
    },
    "timezone": {
      "additionalProperties": false,
      "properties": {
        "value": {
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9/_.+-]+$",
          "title": "Timezone",
          "type": "string",
          "ui": {
            "choice_provider": "timezone",
            "widget": "select"
          }
        }
      },
      "required": [
        "value"
      ],
      "title": "Timezone",
      "type": "object"
    },
    "install": {
      "additionalProperties": false,
      "properties": {},
      "title": "Inputs",
      "type": "object"
    },
    "update": {
      "additionalProperties": false,
      "properties": {},
      "title": "Inputs",
      "type": "object"
    }
  },
  "pages": [],
  "settings_version": 1
}
