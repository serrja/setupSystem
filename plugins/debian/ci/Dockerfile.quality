# syntax=docker/dockerfile:1.27.1@sha256:4edf897a3ffa55b89f906fc8cc78afdb3f1834cc9c7083565e611a8a7d5fe99e
FROM ghcr.io/astral-sh/uv:0.12.15@sha256:62f8c047d0a0e9ece6b53fc63df902585a67a47a7f318ddec4a37db586edc8e3 AS uv
FROM python:3.14.7-slim-bookworm@sha256:82bc3c539b8813ada9d68c63b40158fa002f7f33de9bf3312a3dfdc0620dff56 AS quality-dependencies
COPY --from=uv /uv /usr/local/bin/uv
WORKDIR /workspace
ENV PYTHONDONTWRITEBYTECODE=1 UV_LINK_MODE=copy
COPY . .
RUN apt-get update && apt-get install -y --no-install-recommends make git dpkg-dev && rm -rf /var/lib/apt/lists/*
RUN uv sync --locked --package setup-system-plugin-debian
CMD ["make","-C","plugins/debian","-f","ci/Makefile","check"]
