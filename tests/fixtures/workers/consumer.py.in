from enum import StrEnum
from setup_system_sdk import Backend
from setup_system_sdk.enums.operation import Outcome
from setup_system_sdk.operations import Plan, Result
from setup_system_sdk.providers import CapabilityRequest
from setup_system_sdk.schemas.common import Inputs


class Actions(StrEnum):
    SAVE = "save"


class Plugin(Backend):
    action_inputs = {Actions.SAVE: Inputs}

    async def plan(self, action_id, settings, inputs, context):
        step = await context.plan_provider(
            CapabilityRequest(capability="fixture.write", step_key="publish", payload={})
        )
        return Plan(summary="Write marker", steps=(step,))

    async def verify(self, plan, settings, inputs, context):
        facts = await context.inspect_provider(
            CapabilityRequest(capability="fixture.write", step_key="publish", payload={})
        )
        return Result(
            outcome=Outcome.COMPLETE if facts["exists"] else Outcome.UNKNOWN_OUTCOME,
            message="Observed through provider",
        )
